# ═══════════════════════════════════════════════════════════════════════════════
# MuhafizSRE: Autonomous Incident Guardian
# Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY WARNING: NEVER commit your actual .env file.
# Copy this file to .env and fill in your values.
# All credentials load strictly via os.environ — zero hardcoded keys.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Google Cloud / Gemini API ────────────────────────────────────────────────
# Required: Your Gemini API key from https://aistudio.google.com/apikey
# Google's client SDK reads GEMINI_API_KEY and GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Google Cloud project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ─── Agent Model Configuration ───────────────────────────────────────────────
# All agents use the same configurable model.
MUHAFIZ_DEFAULT_MODEL=gemini-3.1-flash-lite
MUHAFIZ_SPEED_MODEL=gemini-3.1-flash-lite
MUHAFIZ_ANALYTICAL_MODEL=gemini-3-flash-preview
MUHAFIZ_SAFETY_MODEL=gemini-3.1-pro-preview

# ─── MCP Telemetry Server ────────────────────────────────────────────────────
# The MCP server runs as a subprocess (stdio mode) by default.
# Set MCP_TRANSPORT=http for remote/production deployments.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ─── Gateway Server (FastAPI) ────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ─── Security ────────────────────────────────────────────────────────────────
# Secret key for signing the cryptographic audit ledger hash chain.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MUHAFIZ_APPROVAL_SECRET=change-me-to-a-random-64-char-hex-string

# ─── Ledger Database ─────────────────────────────────────────────────────────
# Path to the SQLite ledger file for the cryptographic audit hash chain.
# This file is created at runtime and should NOT be committed to git.
# Code reads MUHAFIZ_LEDGER_DB (see gateway/ledger.py).
MUHAFIZ_LEDGER_DB=muhafiz_ledger.db
